rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function userExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
  function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
  function active() { return userExists() && me().active == true; }
  function owner() { return active() && ((('globalRoles' in me()) && me().globalRoles is list && 'system_owner' in me().globalRoles) || (('roles' in me()) && me().roles is list && 'system_owner' in me().roles)); }
  function operationsPath() { return /databases/$(database)/documents/settings/operations; }
  function hasOperations() { return exists(operationsPath()); }
  function emergencyMode() { return hasOperations() ? get(operationsPath()).data.emergencyMode : 'NORMAL'; }
  function scheduledMaintenance() { return hasOperations() && get(operationsPath()).data.maintenance.enabled == true && get(operationsPath()).data.maintenance.startsAt is timestamp && get(operationsPath()).data.maintenance.endsAt is timestamp && request.time >= get(operationsPath()).data.maintenance.startsAt && request.time < get(operationsPath()).data.maintenance.endsAt; }
  function maintenanceActive() { return emergencyMode() == 'MAINTENANCE' || scheduledMaintenance(); }
  function normalMode() { return !hasOperations() || (emergencyMode() == 'NORMAL' && !scheduledMaintenance()); }
  function essentialMode() { return hasOperations() && emergencyMode() == 'ESSENTIAL_ONLY' && !scheduledMaintenance(); }
  function businessRead() { return owner() ? true : (active() && !maintenanceActive() && emergencyMode() != 'LOCKDOWN'); }
  function ownerBusinessWrite() { return owner() && (normalMode() || maintenanceActive()); }
  function gradeBusinessWrite(y,g) { return owner() ? (normalMode() || maintenanceActive()) : (normalMode() && gradeAdmin(y,g)); }
  function attendanceWriteMode(y,g) { return owner() ? (normalMode() || maintenanceActive()) : (normalMode() ? (gradeAdmin(y,g) || dutyEditable(y,g,request.resource.data.date,request.resource.data.periodId)) : (essentialMode() && dutyEditable(y,g,request.resource.data.date,request.resource.data.periodId))); }
  function validMaintenance(m) { return m.keys().hasOnly(['enabled','title','message','noticeFrom','startsAt','endsAt','bannerEnabled','popupEnabled']) && m.enabled is bool && m.title is string && m.title.size() <= 200 && m.message is string && m.message.size() <= 2000 && (m.noticeFrom == null || m.noticeFrom is timestamp) && (m.startsAt == null || m.startsAt is timestamp) && (m.endsAt == null || m.endsAt is timestamp) && m.bannerEnabled is bool && m.popupEnabled is bool && (!m.enabled || (m.noticeFrom is timestamp && m.startsAt is timestamp && m.endsAt is timestamp && m.noticeFrom <= m.startsAt && m.startsAt < m.endsAt)); }
  function validOperations(d) { return d.keys().hasOnly(['emergencyMode','emergencyMessage','maintenance','updatedAt','updatedBy']) && d.emergencyMode in ['NORMAL','READ_ONLY','ESSENTIAL_ONLY','MAINTENANCE','LOCKDOWN'] && d.emergencyMessage is string && d.emergencyMessage.size() <= 1000 && d.maintenance is map && validMaintenance(d.maintenance) && d.updatedAt is timestamp && d.updatedBy == request.auth.uid; }
  function legacyAdmin() { return owner() || (active() && me().roles is list && 'grade_admin' in me().roles); }
  function aid(y,g,u) { return y + '_' + g + '_' + u; }
  function assigned(y,g) { return active() && exists(/databases/$(database)/documents/staffAssignments/$(aid(y,g,request.auth.uid))) && get(/databases/$(database)/documents/staffAssignments/$(aid(y,g,request.auth.uid))).data.active == true && get(/databases/$(database)/documents/staffAssignments/$(aid(y,g,request.auth.uid))).data.uid == request.auth.uid; }
  function gradeAdmin(y,g) { return owner() || (assigned(y,g) && get(/databases/$(database)/documents/staffAssignments/$(aid(y,g,request.auth.uid))).data.role == 'grade_admin'); }
  function homeLockPath(y,u) { return /databases/$(database)/documents/homeroomAssignments/$(y + '_' + u); }
  function validHome(d, id) { return !('homeroomTeacherUid' in d) || d.homeroomTeacherUid == null || (d.homeroomTeacherUid is string && exists(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,d.homeroomTeacherUid))) && get(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,d.homeroomTeacherUid))).data.active == true && existsAfter(homeLockPath(d.academicYearId,d.homeroomTeacherUid)) && getAfter(homeLockPath(d.academicYearId,d.homeroomTeacherUid)).data.academicYearId == d.academicYearId && getAfter(homeLockPath(d.academicYearId,d.homeroomTeacherUid)).data.gradeId == d.gradeId && getAfter(homeLockPath(d.academicYearId,d.homeroomTeacherUid)).data.uid == d.homeroomTeacherUid && getAfter(homeLockPath(d.academicYearId,d.homeroomTeacherUid)).data.classId == id); }
  function validClass(d) { return d.academicYearId is string && d.gradeId is string && d.classNumber is int && d.active is bool; }
  function validClassHomeUpdate(before, after, id) { return (before.homeroomTeacherUid == after.homeroomTeacherUid && !exists(homeLockPath(before.academicYearId,before.homeroomTeacherUid))) || validHome(after,id); }
  function validStudentClass(d) { return exists(/databases/$(database)/documents/classes/$(d.classId)) && get(/databases/$(database)/documents/classes/$(d.classId)).data.academicYearId == d.academicYearId && get(/databases/$(database)/documents/classes/$(d.classId)).data.gradeId == d.gradeId; }
  function scopedGrade(d) { return d.academicYearId is string && d.gradeId is string && exists(/databases/$(database)/documents/grades/$(d.gradeId)) && get(/databases/$(database)/documents/grades/$(d.gradeId)).data.academicYearId == d.academicYearId; }
  function validSelfStudyGroup(d) { return d.keys().hasOnly(['academicYearId','gradeId','displayName','type','active','sortOrder','createdAt','updatedAt']) && scopedGrade(d) && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 120 && d.type in ['REGULAR','READING'] && d.active is bool && d.sortOrder is int && d.sortOrder >= 0; }
  function sameSelfStudyGroupScope(before, after) { return after.academicYearId == before.academicYearId && after.gradeId == before.gradeId; }
  function validSelfStudyGroupPeriod(d, id) { let group = get(/databases/$(database)/documents/selfStudyGroups/$(d.groupId)).data; let period = get(/databases/$(database)/documents/periods/$(d.periodId)).data; return d.keys().hasOnly(['academicYearId','gradeId','groupId','periodId','active','updatedAt']) && scopedGrade(d) && d.groupId is string && d.periodId is string && id == d.groupId + '_' + d.periodId && d.active is bool && group.academicYearId == d.academicYearId && group.gradeId == d.gradeId && group.active == true && period.academicYearId == d.academicYearId && period.gradeId == d.gradeId && period.active == true; }
  function validSelfStudyMembership(d, id) { let group = get(/databases/$(database)/documents/selfStudyGroups/$(d.selfStudyGroupId)).data; let student = get(/databases/$(database)/documents/students/$(d.studentId)).data; return d.keys().hasOnly(['academicYearId','gradeId','studentId','classId','selfStudyGroupId','active','updatedAt']) && scopedGrade(d) && d.studentId is string && d.classId is string && d.selfStudyGroupId is string && id == d.academicYearId + '_' + d.gradeId + '_' + d.studentId && d.active is bool && group.academicYearId == d.academicYearId && group.gradeId == d.gradeId && (!d.active || group.active == true) && student.academicYearId == d.academicYearId && student.gradeId == d.gradeId && student.classId == d.classId; }
  function validSupervisionAssignment(d, id) { let group = get(/databases/$(database)/documents/selfStudyGroups/$(d.selfStudyGroupId)).data; let period = get(/databases/$(database)/documents/periods/$(d.periodId)).data; let groupPeriod = get(/databases/$(database)/documents/selfStudyGroupPeriods/$(d.selfStudyGroupId + '_' + d.periodId)).data; let teacher = get(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,d.teacherUid))).data; return d.keys().hasOnly(['academicYearId','gradeId','date','periodId','selfStudyGroupId','teacherUid','teacherDisplayName','active','editableFrom','editableUntil','updatedAt']) && d.academicYearId is string && d.gradeId is string && d.date is string && d.periodId is string && d.selfStudyGroupId is string && d.teacherUid is string && d.teacherDisplayName is string && d.teacherDisplayName.size() > 0 && d.teacherDisplayName.size() <= 120 && d.active is bool && (!('editableFrom' in d) || (d.editableFrom is timestamp && d.editableUntil is timestamp && d.editableFrom <= d.editableUntil)) && id == d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + d.teacherUid && group.academicYearId == d.academicYearId && group.gradeId == d.gradeId && group.active == true && period.academicYearId == d.academicYearId && period.gradeId == d.gradeId && period.active == true && groupPeriod.academicYearId == d.academicYearId && groupPeriod.gradeId == d.gradeId && groupPeriod.groupId == d.selfStudyGroupId && groupPeriod.periodId == d.periodId && groupPeriod.active == true && teacher.active == true && teacher.role in ['teacher','grade_admin']; }
  function selfStudyHomeroom(d) { let classRoom = get(/databases/$(database)/documents/classes/$(d.classId)).data; return active() && classRoom.academicYearId == d.academicYearId && classRoom.gradeId == d.gradeId && classRoom.homeroomTeacherUid == request.auth.uid; }
  function validSelfStudyPermission(d, id) { let student = get(/databases/$(database)/documents/students/$(d.studentId)).data; return d.keys().hasOnly(['academicYearId','gradeId','classId','studentId','date','periodIds','reasonCode','reasonText','active','approvedByUid','approvedAt','updatedAt']) && scopedGrade(d) && d.classId is string && d.studentId is string && d.date is string && id == d.academicYearId + '_' + d.gradeId + '_' + d.date + '_' + d.studentId && d.periodIds is list && d.periodIds.size() > 0 && d.reasonCode in ['ACADEMY','MEDICAL','FAMILY','SCHOOL_ACTIVITY','OTHER'] && d.reasonText is string && d.reasonText.size() > 0 && d.reasonText.size() <= 1000 && d.active is bool && d.approvedByUid is string && d.approvedAt is timestamp && student.academicYearId == d.academicYearId && student.gradeId == d.gradeId && student.classId == d.classId; }
  function permissionWritable(d) { return ownerBusinessWrite() || (normalMode() && selfStudyHomeroom(d)); }
  function permissionReadable(d) { return businessRead() && (owner() || gradeAdmin(d.academicYearId,d.gradeId) || selfStudyHomeroom(d)); }
  function validSelfStudyAttendancePermission(d) { let permission = get(/databases/$(database)/documents/selfStudyPermissions/$(d.academicYearId + '_' + d.gradeId + '_' + d.date + '_' + d.studentId)).data; return permission.academicYearId == d.academicYearId && permission.gradeId == d.gradeId && permission.classId == d.classId && permission.studentId == d.studentId && permission.date == d.date && permission.active == true && d.periodId in permission.periodIds && d.permissionId == d.academicYearId + '_' + d.gradeId + '_' + d.date + '_' + d.studentId && d.permissionReasonCode == permission.reasonCode && d.permissionReasonText == permission.reasonText; }
  function validSelfStudyAttendanceRecord(d, id) { let student = get(/databases/$(database)/documents/students/$(d.studentId)).data; let membership = get(/databases/$(database)/documents/selfStudyMemberships/$(d.academicYearId + '_' + d.gradeId + '_' + d.studentId)).data; let group = get(/databases/$(database)/documents/selfStudyGroups/$(d.selfStudyGroupId)).data; let groupPeriod = get(/databases/$(database)/documents/selfStudyGroupPeriods/$(d.selfStudyGroupId + '_' + d.periodId)).data; return d.keys().hasOnly(['academicYearId','gradeId','date','periodId','studentId','classId','selfStudyGroupId','status','permissionId','permissionReasonCode','permissionReasonText','recordedByUid','recordedAt','updatedByUid','updatedAt','schemaVersion']) && d.status in ['PRESENT','EXCUSED_ABSENCE','UNEXCUSED_ABSENCE'] && d.recordedByUid is string && d.recordedAt is timestamp && d.updatedByUid == request.auth.uid && d.updatedAt is timestamp && d.schemaVersion == 1 && id == d.academicYearId + '_' + d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.studentId && student.active == true && student.academicYearId == d.academicYearId && student.gradeId == d.gradeId && student.classId == d.classId && membership.active == true && membership.classId == d.classId && membership.selfStudyGroupId == d.selfStudyGroupId && group.active == true && group.academicYearId == d.academicYearId && group.gradeId == d.gradeId && groupPeriod.active == true && groupPeriod.groupId == d.selfStudyGroupId && groupPeriod.periodId == d.periodId && ((d.status == 'EXCUSED_ABSENCE' && d.permissionId is string && d.permissionReasonCode in ['ACADEMY','MEDICAL','FAMILY','SCHOOL_ACTIVITY','OTHER'] && d.permissionReasonText is string && validSelfStudyAttendancePermission(d)) || (d.status != 'EXCUSED_ABSENCE' && !('permissionId' in d) && !('permissionReasonCode' in d) && !('permissionReasonText' in d))); }
  function selfStudySupervisorWritable(d) { let assignment = exists(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)) ? get(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)).data : {}; return active() && normalMode() && assignment.keys().hasAll(['teacherUid','active','editableFrom','editableUntil']) && assignment.teacherUid == request.auth.uid && assignment.active == true && assignment.editableFrom is timestamp && assignment.editableUntil is timestamp && request.time >= assignment.editableFrom && request.time <= assignment.editableUntil; }
  function selfStudyAttendanceAdminWritable(d) { return (owner() && (normalMode() || maintenanceActive())) || (active() && normalMode() && exists(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,request.auth.uid))) && get(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,request.auth.uid))).data.active == true && get(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,request.auth.uid))).data.role == 'grade_admin'); }
  function selfStudyAttendanceWritable(d) { return selfStudySupervisorWritable(d) || selfStudyAttendanceAdminWritable(d); }
  function selfStudyAttendanceReadable(d) { return businessRead() && (owner() || gradeAdmin(d.academicYearId,d.gradeId) || selfStudyHomeroom(d) || (exists(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)) && get(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)).data.active == true && get(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.date + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)).data.teacherUid == request.auth.uid)); }
  function legacyDuty(date, period) { return active() && exists(/databases/$(database)/documents/dutyAssignments/$(date)) && get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods is map && period in get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods && get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods[period].teacherUid == request.auth.uid && get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods[period].editableFrom is timestamp && get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods[period].editableUntil is timestamp && request.time >= get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods[period].editableFrom && request.time <= get(/databases/$(database)/documents/dutyAssignments/$(date)).data.periods[period].editableUntil; }
  function validDutyParent(d, id) { let grade = get(/databases/$(database)/documents/grades/$(d.gradeId)).data; return d.keys().hasOnly(['academicYearId','gradeId','date','schemaVersion','updatedAt']) && d.academicYearId is string && d.gradeId is string && d.date is string && d.schemaVersion == 2 && d.updatedAt is timestamp && id == d.gradeId + '_' + d.date && grade.academicYearId == d.academicYearId; }
  function sameDutyParentScope(before, after) { return after.academicYearId == before.academicYearId && after.gradeId == before.gradeId && after.date == before.date && after.schemaVersion == before.schemaVersion; }
  function dutyParentReadable(d) { return businessRead() && (owner() || (('schemaVersion' in d) && d.schemaVersion == 2 && ('academicYearId' in d) && ('gradeId' in d) && assigned(d.academicYearId,d.gradeId))); }
  function validDutyChild(d, parent, periodId) { let period = get(/databases/$(database)/documents/periods/$(periodId)).data; let teacher = get(/databases/$(database)/documents/staffAssignments/$(aid(d.academicYearId,d.gradeId,d.teacherUid))).data; return d.keys().hasOnly(['academicYearId','gradeId','date','periodId','teacherUid','teacherName','teacherEmail','editableFrom','editableUntil','updatedAt']) && d.academicYearId == parent.academicYearId && d.gradeId == parent.gradeId && d.date == parent.date && d.periodId == periodId && d.teacherUid is string && d.teacherName is string && d.teacherName.size() <= 100 && (!('teacherEmail' in d) || (d.teacherEmail is string && d.teacherEmail.size() <= 254)) && d.editableFrom is timestamp && d.editableUntil is timestamp && d.editableFrom < d.editableUntil && period.active == true && period.academicYearId == d.academicYearId && period.gradeId == d.gradeId && teacher.active == true && teacher.role in ['teacher','grade_admin']; }
  function validException(d) { return d.keys().hasOnly(['academicYearId','scopeType','gradeId','date','reasonType','reason','active','periodIds']) && d.academicYearId is string && d.scopeType in ['school','grade'] && d.date is string && d.reasonType in ['holiday','exam','school_event','manual'] && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 500 && d.active is bool && (!('periodIds' in d) || (d.periodIds is list && d.periodIds.size() > 0)) && ((d.scopeType == 'school' && d.gradeId == null) || (d.scopeType == 'grade' && d.gradeId is string && exists(/databases/$(database)/documents/grades/$(d.gradeId)) && get(/databases/$(database)/documents/grades/$(d.gradeId)).data.academicYearId == d.academicYearId)); }
  function exceptionReadable(d) { return businessRead() && (owner() || (active() && ('scopeType' in d) && ('academicYearId' in d) && ('gradeId' in d) && ((d.scopeType == 'school' && d.gradeId == null) || (d.scopeType == 'grade' && assigned(d.academicYearId,d.gradeId))))); }
  function sameExceptionScope(before, after) { return after.academicYearId == before.academicYearId && after.scopeType == before.scopeType && after.gradeId == before.gradeId && after.date == before.date; }
  function dutyChild(y,g,date,period) { return get(/databases/$(database)/documents/dutyAssignments/$(g + '_' + date)/periods/$(period)).data; }
  function validDutyForAttendance(y,g,date,period) { let child = dutyChild(y,g,date,period); return child.academicYearId == y && child.gradeId == g && child.date == date && child.periodId == period; }
  function dutyAssigned(y,g,date,period) { let child = dutyChild(y,g,date,period); return assigned(y,g) && child.academicYearId == y && child.gradeId == g && child.date == date && child.periodId == period && child.teacherUid == request.auth.uid; }
  function dutyEditable(y,g,date,period) { let child = dutyChild(y,g,date,period); return assigned(y,g) && child.academicYearId == y && child.gradeId == g && child.date == date && child.periodId == period && child.teacherUid == request.auth.uid && child.editableFrom is timestamp && child.editableUntil is timestamp && request.time >= child.editableFrom && request.time <= child.editableUntil; }
  function homeroomRecord(d) { let classRoom = get(/databases/$(database)/documents/classes/$(d.classId)).data; return active() && classRoom.academicYearId == d.academicYearId && classRoom.gradeId == d.gradeId && classRoom.homeroomTeacherUid == request.auth.uid; }
  function attendanceClassMatches(d) { let classRoom = get(/databases/$(database)/documents/classes/$(d.classId)).data; return classRoom.academicYearId == d.academicYearId && classRoom.gradeId == d.gradeId && classRoom.active == true; }
  function attendanceStudentMatches(d) { let student = get(/databases/$(database)/documents/students/$(d.studentId)).data; return student.academicYearId == d.academicYearId && student.gradeId == d.gradeId && student.classId == d.classId && student.active == true; }
  function attendancePeriodMatches(d) { let period = get(/databases/$(database)/documents/periods/$(d.periodId)).data; return period.academicYearId == d.academicYearId && period.gradeId == d.gradeId && period.active == true; }
  function validAttendanceRecord(d, dayId, recordId) { return d.keys().hasOnly(['academicYearId','gradeId','date','classId','studentId','periodId','status','note','markedBy','markedAt','updatedAt']) && d.status in ['present','late','absent','excused','early_leave'] && d.note is string && d.note.size() <= 1000 && d.markedBy == request.auth.uid && d.markedAt is timestamp && d.updatedAt is timestamp && dayId == d.gradeId + '_' + d.date && recordId == d.classId + '__' + d.periodId + '__' + d.studentId && attendanceClassMatches(d) && attendanceStudentMatches(d) && attendancePeriodMatches(d); }
  function sameAttendanceIdentity(before, after) { return after.academicYearId == before.academicYearId && after.gradeId == before.gradeId && after.date == before.date && after.classId == before.classId && after.studentId == before.studentId && after.periodId == before.periodId; }
  function attendanceReadable(d) { return businessRead() && (owner() || gradeAdmin(d.academicYearId,d.gradeId) || homeroomRecord(d) || dutyAssigned(d.academicYearId,d.gradeId,d.date,d.periodId)); }
  function attendanceWritable(d) { return attendanceWriteMode(d.academicYearId,d.gradeId); }
  function validAudit(d) { return d.keys().hasOnly(['actorUid','actorName','action','targetType','targetId','before','after','source','batchId','batchSize','academicYearId','gradeId','classId','studentId','periodId','selfStudyGroupId','dutyDate','timestamp']) && d.keys().hasAll(['actorUid','actorName','action','targetType','targetId','before','after','source','timestamp']) && d.actorUid == request.auth.uid && d.actorName is string && d.action is string && d.targetType is string && d.targetId is string && (d.before == null || d.before is map) && (d.after == null || d.after is map) && d.source in ['manual','excel','system'] && d.timestamp is timestamp; }
  function scopedAudit(d) { return ('academicYearId' in d) && ('gradeId' in d) && d.academicYearId is string && d.gradeId is string; }
  function auditReadable(d) { return businessRead() && !essentialMode() && (owner() || gradeAuditWritable(d)); }
  function gradeAuditWritable(d) { return scopedAudit(d) && gradeAdmin(d.academicYearId,d.gradeId); }
  function dutyAuditWritable(d) { return scopedAudit(d) && ('periodId' in d) && ('dutyDate' in d) && d.periodId is string && d.dutyDate is string && dutyEditable(d.academicYearId,d.gradeId,d.dutyDate,d.periodId); }
  function supervisionAuditWritable(d) { let assignment = exists(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.dutyDate + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)) ? get(/databases/$(database)/documents/supervisionAssignments/$(d.gradeId + '_' + d.dutyDate + '_' + d.periodId + '_' + d.selfStudyGroupId + '_' + request.auth.uid)).data : {}; return scopedAudit(d) && ('periodId' in d) && ('dutyDate' in d) && ('selfStudyGroupId' in d) && d.periodId is string && d.dutyDate is string && d.selfStudyGroupId is string && active() && normalMode() && assignment.keys().hasAll(['teacherUid','active','editableFrom','editableUntil']) && assignment.active == true && assignment.teacherUid == request.auth.uid && assignment.editableFrom is timestamp && assignment.editableUntil is timestamp && request.time >= assignment.editableFrom && request.time <= assignment.editableUntil; }
  function homeroomAuditWritable(d) { return scopedAudit(d) && ('classId' in d) && d.classId is string && selfStudyHomeroom(d); }
  function auditWritable(d) { return normalMode() ? (owner() || gradeAuditWritable(d) || dutyAuditWritable(d) || supervisionAuditWritable(d) || homeroomAuditWritable(d)) : (essentialMode() ? dutyAuditWritable(d) : (maintenanceActive() && owner())); }

  match /users/{uid} { allow read: if signedIn() && (uid == request.auth.uid || (owner() && businessRead())); allow write: if ownerBusinessWrite(); }
  match /pendingUsers/{uid} {
    allow read: if signedIn() && (uid == request.auth.uid || (owner() && businessRead()));
    allow create: if signedIn() && uid == request.auth.uid && !exists(/databases/$(database)/documents/users/$(uid)) && request.resource.data.keys().hasOnly(['uid','email','displayName','provider','createdAt','lastLoginAt']) && request.resource.data.uid == uid && request.resource.data.email is string && request.resource.data.displayName is string && request.resource.data.provider == 'google';
    allow update: if ownerBusinessWrite() || (signedIn() && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','lastLoginAt']) && request.resource.data.uid == resource.data.uid && request.resource.data.provider == 'google');
    allow delete: if ownerBusinessWrite();
  }
  match /academicYears/{id} { allow read: if businessRead() && (owner() || (active() && resource.data.active == true)); allow write: if ownerBusinessWrite(); }
  match /grades/{id} { allow read: if businessRead() && (owner() || (active() && resource.data.gradeId == id && assigned(resource.data.academicYearId,id))); allow write: if ownerBusinessWrite(); }
  match /staffAssignments/{id} {
    allow read: if businessRead() && (owner() || (active() && (resource.data.uid == request.auth.uid || gradeAdmin(resource.data.academicYearId,resource.data.gradeId))));
    allow create: if ownerBusinessWrite() && id == aid(request.resource.data.academicYearId,request.resource.data.gradeId,request.resource.data.uid) && request.resource.data.role in ['teacher','grade_admin'] && request.resource.data.active is bool && request.resource.data.keys().hasOnly(['academicYearId','gradeId','uid','role','active','displayName','createdAt','updatedAt']) && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120));
    allow update: if ownerBusinessWrite() && id == aid(request.resource.data.academicYearId,request.resource.data.gradeId,request.resource.data.uid) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.uid == resource.data.uid && (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120));
    allow delete: if ownerBusinessWrite();
  }
  match /classes/{id} {
    allow read: if businessRead() && (owner() || (active() && ('academicYearId' in resource.data) && ('gradeId' in resource.data) && assigned(resource.data.academicYearId,resource.data.gradeId)));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validClass(request.resource.data) && validHome(request.resource.data,id);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validClass(request.resource.data) && validClassHomeUpdate(resource.data,request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId;
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId);
  }
  match /homeroomAssignments/{id} {
    allow get: if businessRead() && active();
    allow list: if false;
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && id == request.resource.data.academicYearId + '_' + request.resource.data.uid && request.resource.data.keys().hasOnly(['academicYearId','gradeId','uid','classId','classDisplayName','updatedAt']) && request.resource.data.uid is string && request.resource.data.classId is string && request.resource.data.classDisplayName is string && request.resource.data.classDisplayName.size() <= 120 && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.homeroomTeacherUid == request.resource.data.uid;
    allow update: if false;
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && getAfter(/databases/$(database)/documents/classes/$(resource.data.classId)).data.homeroomTeacherUid != resource.data.uid;
  }
  match /students/{id} {
    allow read: if businessRead() && (owner() || (active() && ('academicYearId' in resource.data) && ('gradeId' in resource.data) && assigned(resource.data.academicYearId,resource.data.gradeId)));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && request.resource.data.academicYearId is string && request.resource.data.gradeId is string && request.resource.data.classId is string && validStudentClass(request.resource.data);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.classId == resource.data.classId && validStudentClass(request.resource.data);
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId);
  }
  match /periods/{id} {
    allow read: if businessRead() && (owner() || (active() && ('academicYearId' in resource.data) && ('gradeId' in resource.data) && assigned(resource.data.academicYearId,resource.data.gradeId)));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && request.resource.data.academicYearId is string && request.resource.data.gradeId is string;
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId;
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId);
  }
  match /dutyAssignments/{id} {
    allow read: if dutyParentReadable(resource.data);
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validDutyParent(request.resource.data,id);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validDutyParent(request.resource.data,id) && sameDutyParentScope(resource.data,request.resource.data);
    allow delete: if false;
    match /periods/{periodId} {
      allow read: if exists(/databases/$(database)/documents/dutyAssignments/$(id)) && dutyParentReadable(get(/databases/$(database)/documents/dutyAssignments/$(id)).data);
      allow create: if existsAfter(/databases/$(database)/documents/dutyAssignments/$(id)) && gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validDutyParent(getAfter(/databases/$(database)/documents/dutyAssignments/$(id)).data,id) && validDutyChild(request.resource.data,getAfter(/databases/$(database)/documents/dutyAssignments/$(id)).data,periodId);
      allow update: if exists(/databases/$(database)/documents/dutyAssignments/$(id)) && gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.date == resource.data.date && request.resource.data.periodId == resource.data.periodId && validDutyParent(getAfter(/databases/$(database)/documents/dutyAssignments/$(id)).data,id) && validDutyChild(request.resource.data,getAfter(/databases/$(database)/documents/dutyAssignments/$(id)).data,periodId);
      allow delete: if exists(/databases/$(database)/documents/dutyAssignments/$(id)) && gradeBusinessWrite(get(/databases/$(database)/documents/dutyAssignments/$(id)).data.academicYearId,get(/databases/$(database)/documents/dutyAssignments/$(id)).data.gradeId);
    }
  }
  match /selfStudyExceptions/{id} {
    allow read: if exceptionReadable(resource.data);
    allow create: if validException(request.resource.data) && ((request.resource.data.scopeType == 'school' && ownerBusinessWrite()) || (request.resource.data.scopeType == 'grade' && gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId)));
    allow update: if validException(request.resource.data) && sameExceptionScope(resource.data,request.resource.data) && ((resource.data.scopeType == 'school' && ownerBusinessWrite()) || (resource.data.scopeType == 'grade' && gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId)));
    allow delete: if (resource.data.scopeType == 'school' && ownerBusinessWrite()) || (resource.data.scopeType == 'grade' && gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId));
  }
  match /selfStudyGroups/{id} {
    allow read: if businessRead() && (owner() || assigned(resource.data.academicYearId,resource.data.gradeId));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validSelfStudyGroup(request.resource.data);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validSelfStudyGroup(request.resource.data) && sameSelfStudyGroupScope(resource.data,request.resource.data);
    allow delete: if false;
  }
  match /selfStudyGroupPeriods/{id} {
    allow read: if businessRead() && (owner() || assigned(resource.data.academicYearId,resource.data.gradeId));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validSelfStudyGroupPeriod(request.resource.data,id);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validSelfStudyGroupPeriod(request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.groupId == resource.data.groupId && request.resource.data.periodId == resource.data.periodId;
    allow delete: if false;
  }
  match /selfStudyMemberships/{id} {
    allow read: if businessRead() && (owner() || assigned(resource.data.academicYearId,resource.data.gradeId) || selfStudyHomeroom(resource.data));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validSelfStudyMembership(request.resource.data,id);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validSelfStudyMembership(request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.studentId == resource.data.studentId;
    allow delete: if false;
  }
  match /supervisionAssignments/{id} {
    allow read: if businessRead() && (owner() || gradeAdmin(resource.data.academicYearId,resource.data.gradeId) || (assigned(resource.data.academicYearId,resource.data.gradeId) && resource.data.teacherUid == request.auth.uid));
    allow create: if gradeBusinessWrite(request.resource.data.academicYearId,request.resource.data.gradeId) && validSupervisionAssignment(request.resource.data,id);
    allow update: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId) && validSupervisionAssignment(request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.date == resource.data.date && request.resource.data.periodId == resource.data.periodId && request.resource.data.selfStudyGroupId == resource.data.selfStudyGroupId && request.resource.data.teacherUid == resource.data.teacherUid;
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId);
  }
  match /selfStudyAttendanceRecords/{id} {
    allow read: if selfStudyAttendanceReadable(resource.data);
    allow create: if validSelfStudyAttendanceRecord(request.resource.data,id) && request.resource.data.recordedByUid == request.auth.uid && selfStudyAttendanceWritable(request.resource.data);
    allow update: if validSelfStudyAttendanceRecord(request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.date == resource.data.date && request.resource.data.periodId == resource.data.periodId && request.resource.data.studentId == resource.data.studentId && request.resource.data.classId == resource.data.classId && request.resource.data.selfStudyGroupId == resource.data.selfStudyGroupId && request.resource.data.recordedByUid == resource.data.recordedByUid && request.resource.data.recordedAt == resource.data.recordedAt && selfStudyAttendanceWritable(request.resource.data);
    allow delete: if false;
  }
  match /selfStudyPermissions/{id} {
    allow read: if permissionReadable(resource.data);
    allow create: if validSelfStudyPermission(request.resource.data,id) && request.resource.data.approvedByUid == request.auth.uid && permissionWritable(request.resource.data);
    allow update: if validSelfStudyPermission(request.resource.data,id) && request.resource.data.academicYearId == resource.data.academicYearId && request.resource.data.gradeId == resource.data.gradeId && request.resource.data.classId == resource.data.classId && request.resource.data.studentId == resource.data.studentId && request.resource.data.date == resource.data.date && request.resource.data.approvedByUid == resource.data.approvedByUid && request.resource.data.approvedAt == resource.data.approvedAt && permissionWritable(request.resource.data);
    allow delete: if false;
  }
  match /attendance/{id}/records/{record} {
    allow read: if attendanceReadable(resource.data);
    allow create: if validAttendanceRecord(request.resource.data,id,record) && attendanceWritable(request.resource.data);
    allow update: if validAttendanceRecord(request.resource.data,id,record) && sameAttendanceIdentity(resource.data,request.resource.data) && attendanceWritable(request.resource.data);
    allow delete: if gradeBusinessWrite(resource.data.academicYearId,resource.data.gradeId);
  }
  // Firestore collection-group history queries require a recursive match in rules v2.
  match /{path=**}/records/{record} { allow read: if attendanceReadable(resource.data); }
  match /statistics/{id} { allow read: if businessRead() && !essentialMode() && legacyAdmin(); allow write: if ownerBusinessWrite(); }
  match /settings/operations { allow read: if signedIn(); allow create, update: if owner() && validOperations(request.resource.data); allow delete: if false; }
  match /settings/{id} { allow read: if id != 'operations' && businessRead(); allow write: if id != 'operations' && ownerBusinessWrite(); }
  match /auditLogs/{id} { allow read: if auditReadable(resource.data); allow create: if validAudit(request.resource.data) && auditWritable(request.resource.data); allow update, delete: if false; }
  match /{document=**} { allow read, write: if false; }
} }
