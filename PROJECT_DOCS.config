# Project Documentation Automation Config
README_AUTO_UPDATE=true
CHANGELOG_AUTO_UPDATE=true
DEPLOYMENT_AUTO_UPDATE=true

# Intentionally paused. Change to true later to re-enable automatic development logs.
DEVLOG_AUTO_UPDATE=false
DEVLOG_ROOT=개발일지
DEVLOG_MODE=project_policy

# Only touch a document when the current task materially affects it.
UPDATE_ONLY_WHEN_RELEVANT=true
